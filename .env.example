# Local: copy to repo-root `.env`. Vercel: set the same keys in Project → Environment Variables.

# Tier 2 — official deprecation pages (pick one reader)
OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# SUNDOWN_LLM_MODEL=openai/gpt-4o-mini

# GitHub — tarball download + archived repo checks (recommended for web scans)
# CLI --issue and weekly Action upsert one issue labeled "sundown" (needs gh CLI + issues: write)
# GITHUB_TOKEN=

# If auto-detect fails (e.g. Vercel): repo root or path to registry/ folder
# SUNDOWN_MONOREPO_ROOT=
# REGISTRY_PATH=

# Include *.test.ts and **/fixtures/** when walking a repo (default: skip)
# SUNDOWN_INCLUDE_TESTS=1

# Landing CTA — monitoring / product interest (local dev + Vercel)
# NEXT_PUBLIC_CONTACT_URL=https://example.com/contact

# Optional — local only: schedule LinkedIn via Zernio (scripts/schedule-linkedin-zernio.mjs)
# ZERNIO_API_KEY=