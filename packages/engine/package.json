{
  "name": "sundown-engine",
  "version": "0.1.1",
  "description": "Sundown scan engine — expiry audit for models, APIs, packages, runtimes, SaaS.",
  "license": "MIT",
  "author": "Sid Venkatesh",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sid-venkatesh/project-sundown.git",
    "directory": "packages/engine"
  },
  "homepage": "https://github.com/sid-venkatesh/project-sundown",
  "bugs": {
    "url": "https://github.com/sid-venkatesh/project-sundown/issues"
  },
  "keywords": [
    "deprecation",
    "eol",
    "audit",
    "sundown"
  ],
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./report": {
      "types": "./dist/report.d.ts",
      "import": "./dist/report.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "registry"
  ],
  "scripts": {
    "copy-registry": "node ../../scripts/copy-registry.mjs",
    "build": "npm run copy-registry && tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "fast-glob": "^3.3.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
